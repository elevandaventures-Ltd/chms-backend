# Redis 7 — running on host port 6379
REDIS_URL=redis://localhost:6379

# Meilisearch — running on host port 7700
MEILI_HOST=http://localhost:7700
# Override in your local .env; do not commit a real key.
MEILI_MASTER_KEY=masterKey

# Sentry — leave SENTRY_DSN blank to disable.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
