# Supabase — local dev defaults below come from `supabase start` / `supabase status`.
# Run `supabase status` to confirm the keys for your machine, and never commit
# real (cloud) keys.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Shared HS256 secret used to verify access tokens. Local default shown.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# API server
PORT=3001
HOST=0.0.0.0
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Global rate limit: requests per client per window.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Redis 7 — running on host port 6379
REDIS_URL=redis://localhost:6379

# Meilisearch — running on host port 7700
MEILI_HOST=http://localhost:7700
# Override in your local .env; do not commit a real key.
MEILI_MASTER_KEY=masterKey

# Sentry — leave SENTRY_DSN blank to disable.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
