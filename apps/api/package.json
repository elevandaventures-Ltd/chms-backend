{
  "name": "api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --import ./src/instrument.ts src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env --import ./src/instrument.ts src/server.ts",
    "build": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 \"src/**/*.ts\"",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@repo/db": "*",
    "@sentry/node": "^10.56.0",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.1",
    "tsx": "^4.19.2",
    "typescript": "5.9.2",
    "vitest": "^3.2.4"
  }
}
