{
  "name": "api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --import ./src/instrument.ts src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env --import ./src/instrument.ts src/server.ts",
    "build": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 \"src/**/*.ts\"",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "job:aging-alerts": "tsx --env-file-if-exists=../../.env src/jobs/run-aging-alerts.ts",
    "job:reindex": "tsx --env-file-if-exists=../../.env src/jobs/reindex-search.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@repo/api-types": "*",
    "@repo/db": "*",
    "@sentry/node": "^10.56.0",
    "csv-parse": "^7.0.0",
    "csv-stringify": "^6.8.0",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^6.1.0",
    "jose": "^5.9.6",
    "meilisearch": "^0.58.0",
    "pdfkit": "^0.19.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^22.15.3",
    "@types/pdfkit": "^0.17.6",
    "eslint": "^9.39.1",
    "tsx": "^4.19.2",
    "typescript": "5.9.2",
    "vitest": "^3.2.4"
  }
}
